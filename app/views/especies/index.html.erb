<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Espécies</h1>
  <%= link_to "Nova espécie", new_especie_path, class: "btn btn-primary" %>
</div>

<%= form_with url: especies_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por código ou descrição", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Código</th>
        <th>Descrição</th>
        <th>CD2</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @especies.each do |especie| %>
        <tr>
          <td><%= especie.codigo.present? ? link_to(especie.codigo, especie) : "(sem código)" %></td>
          <td><%= especie.descricao %></td>
          <td><%= especie.cd2 %></td>
          <td class="text-end">
            <% if especie.codigo.present? %>
              <%= link_to "Editar", edit_especie_path(especie), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Remover", especie, data: { turbo_method: :delete, turbo_confirm: "Remover #{especie.descricao}?" }, class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
