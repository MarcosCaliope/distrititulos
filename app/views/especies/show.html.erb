<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= @especie.descricao %></h1>
  <div>
    <%= link_to "Editar", edit_especie_path(@especie), class: "btn btn-primary" %>
    <%= link_to "Voltar", especies_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><strong>Código:</strong> <%= @especie.codigo %></li>
    <li class="list-group-item"><strong>Descrição:</strong> <%= @especie.descricao %></li>
    <li class="list-group-item"><strong>CD2:</strong> <%= @especie.cd2 %></li>
  </ul>
</div>
