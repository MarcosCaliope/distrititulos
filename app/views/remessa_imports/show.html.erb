<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Importação de <%= @state[:filename] %></h1>
  <%= link_to "Nova importação", new_remessa_import_path, class: "btn btn-outline-secondary" %>
</div>

<%= turbo_stream_from "remessa_import_#{@id}" %>

<%= render "progress", state: @state %>

<div class="card">
  <div class="card-header">Log de Importação</div>
  <div id="remessa_import_log" class="card-body" style="white-space: pre-wrap;">
    <% @state[:log].each do |mensagem| %>
      <%= render "log_line", mensagem: mensagem %>
    <% end %>
  </div>
</div>
