<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Distribuidores</h1>
  <%= link_to "Novo distribuidor", new_distribuidor_path, class: "btn btn-primary" %>
</div>

<%= form_with url: distribuidores_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por cartório", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Cartório</th>
        <th>Livre</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @distribuidores.each do |distribuidor| %>
        <tr>
          <td><%= distribuidor.dis_id %></td>
          <td><%= link_to distribuidor.dis_cartorio, distribuidor %></td>
          <td><%= distribuidor.blivre ? "Sim" : "Não" %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_distribuidor_path(distribuidor), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", distribuidor, data: { turbo_method: :delete, turbo_confirm: "Remover #{distribuidor.dis_cartorio}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
