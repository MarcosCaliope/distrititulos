<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Devedores solidários</h1>
  <%= link_to "Novo devedor solidário", new_devedor_solidario_path, class: "btn btn-primary" %>
</div>

<%= form_with url: devedor_solidarios_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por CPF/CNPJ, protocolo ou número do título", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Tipo</th>
        <th>CPF/CNPJ</th>
        <th>Protocolo</th>
        <th>Nº título</th>
        <th>Espécie</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @devedor_solidarios.each do |devedor_solidario| %>
        <tr>
          <td><%= devedor_solidario.tipo_doc %></td>
          <td><%= devedor_solidario.cpf_cgc %></td>
          <td><%= link_to devedor_solidario.protocolo, devedor_solidario %></td>
          <td><%= devedor_solidario.snumtitulo %></td>
          <td><%= devedor_solidario.especie %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_devedor_solidario_path(devedor_solidario), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", devedor_solidario, data: { turbo_method: :delete, turbo_confirm: "Remover o registro #{devedor_solidario.protocolo}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
