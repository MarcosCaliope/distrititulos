<%= form_with model: feriado do |f| %>
  <% if feriado.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h5"><%= pluralize(feriado.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul class="mb-0">
        <% feriado.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :dtferiado, "Data", class: "form-label" %>
    <%= f.date_field :dtferiado, readonly: feriado.persisted?, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :sdescricao, "Descrição", class: "form-label" %>
    <%= f.text_field :sdescricao, maxlength: 50, class: "form-control" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
