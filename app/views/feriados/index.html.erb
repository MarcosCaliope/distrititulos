<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Feriados</h1>
  <%= link_to "Novo feriado", new_feriado_path, class: "btn btn-primary" %>
</div>

<%= form_with url: feriados_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por descrição", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= number_field_tag :ano, params[:ano], placeholder: "Ano", min: 1900, max: 2999, class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Data</th>
        <th>Descrição</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @feriados.each do |feriado| %>
        <tr>
          <td><%= link_to feriado.dtferiado, feriado %></td>
          <td><%= feriado.sdescricao %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_feriado_path(feriado), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", feriado, data: { turbo_method: :delete, turbo_confirm: "Remover #{feriado.sdescricao}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " com os filtros aplicados" if params.values_at(:q, :ano).any?(&:present?) %>.</p>
