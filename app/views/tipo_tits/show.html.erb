<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= @tipo_tit.descricao %></h1>
  <div>
    <%= link_to "Editar", edit_tipo_tit_path(@tipo_tit), class: "btn btn-primary" %>
    <%= link_to "Voltar", tipo_tits_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><strong>Código:</strong> <%= @tipo_tit.codigo %></li>
    <li class="list-group-item"><strong>Descrição:</strong> <%= @tipo_tit.descricao %></li>
    <li class="list-group-item"><strong>Abreviação:</strong> <%= @tipo_tit.abrevia %></li>
  </ul>
</div>
