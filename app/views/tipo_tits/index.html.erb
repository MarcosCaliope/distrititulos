<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Tipos de título</h1>
  <%= link_to "Novo tipo de título", new_tipo_tit_path, class: "btn btn-primary" %>
</div>

<%= form_with url: tipo_tits_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por código, descrição ou abreviação", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Código</th>
        <th>Descrição</th>
        <th>Abreviação</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @tipo_tits.each do |tipo_tit| %>
        <tr>
          <td><%= tipo_tit.codigo.present? ? link_to(tipo_tit.codigo, tipo_tit) : "(sem código)" %></td>
          <td><%= tipo_tit.descricao %></td>
          <td><%= tipo_tit.abrevia %></td>
          <td class="text-end">
            <% if tipo_tit.codigo.present? %>
              <%= link_to "Editar", edit_tipo_tit_path(tipo_tit), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Remover", tipo_tit, data: { turbo_method: :delete, turbo_confirm: "Remover #{tipo_tit.descricao}?" }, class: "btn btn-sm btn-outline-danger" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
