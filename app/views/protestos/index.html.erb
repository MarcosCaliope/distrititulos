<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Protestos</h1>
  <%= link_to "Novo protesto", new_protesto_path, class: "btn btn-primary" %>
</div>

<%= form_with url: protestos_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por cartório ou e-mail", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Cartório</th>
        <th>E-mail</th>
        <th>Oficial</th>
        <th>Fone</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @protestos.each do |protesto| %>
        <tr>
          <td><%= protesto.pro_id %></td>
          <td><%= link_to protesto.pro_cartorio, protesto %></td>
          <td><%= protesto.pro_email %></td>
          <td><%= protesto.pro_oficial %></td>
          <td><%= protesto.pro_fone %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_protesto_path(protesto), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", protesto, data: { turbo_method: :delete, turbo_confirm: "Remover #{protesto.pro_cartorio}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
