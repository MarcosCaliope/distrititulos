<%= form_with model: protesto do |f| %>
  <% if protesto.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h5"><%= pluralize(protesto.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul class="mb-0">
        <% protesto.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :pro_id, "ID", class: "form-label" %>
    <%= f.text_field :pro_id, maxlength: 1, readonly: protesto.persisted?, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :pro_cartorio, "Cartório", class: "form-label" %>
    <%= f.text_field :pro_cartorio, maxlength: 40, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :pro_email, "E-mail", class: "form-label" %>
    <%= f.text_field :pro_email, maxlength: 150, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :pro_oficial, "Oficial", class: "form-label" %>
    <%= f.text_field :pro_oficial, maxlength: 40, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :pro_fone, "Fone", class: "form-label" %>
    <%= f.text_field :pro_fone, maxlength: 12, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :id_prot_escritura, "ID protocolo escritura", class: "form-label" %>
    <%= f.text_field :id_prot_escritura, maxlength: 4, class: "form-control" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :ativa_sc_titulos, class: "form-check-input" %>
    <%= f.label :ativa_sc_titulos, "Ativa SC títulos", class: "form-check-label" %>
  </div>

  <div class="mb-3">
    <%= f.label :scopiaemail, "Cópia de e-mail", class: "form-label" %>
    <%= f.text_field :scopiaemail, maxlength: 100, class: "form-control" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :blivre, class: "form-check-input" %>
    <%= f.label :blivre, "Livre", class: "form-check-label" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
