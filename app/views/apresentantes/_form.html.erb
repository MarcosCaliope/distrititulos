<%= form_with model: apresentante do |f| %>
  <% if apresentante.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h5"><%= pluralize(apresentante.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul class="mb-0">
        <% apresentante.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :codigo, class: "form-label" %>
    <%= f.text_field :codigo, maxlength: 6, readonly: apresentante.persisted?, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :nome, class: "form-label" %>
    <%= f.text_field :nome, maxlength: 30, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :endereco, "Endereço", class: "form-label" %>
    <%= f.text_field :endereco, maxlength: 30, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :fone, class: "form-label" %>
    <%= f.text_field :fone, maxlength: 20, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :contato, class: "form-label" %>
    <%= f.text_field :contato, maxlength: 40, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :agencia, class: "form-label" %>
    <%= f.text_field :agencia, maxlength: 20, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :tipo, class: "form-label" %>
    <%= f.text_field :tipo, maxlength: 1, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :convenio, class: "form-label" %>
    <%= f.text_field :convenio, maxlength: 1, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :scustaantecipada, "Custa antecipada", class: "form-label" %>
    <%= f.text_field :scustaantecipada, maxlength: 1, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :scodcompensacao, "Código de compensação", class: "form-label" %>
    <%= f.text_field :scodcompensacao, maxlength: 6, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :scnpj, "CNPJ", class: "form-label" %>
    <%= f.text_field :scnpj, maxlength: 14, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :scep, "CEP", class: "form-label" %>
    <%= f.text_field :scep, maxlength: 10, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :scidade, "Cidade", class: "form-label" %>
    <%= f.text_field :scidade, maxlength: 20, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :sestado, "Estado", class: "form-label" %>
    <%= f.text_field :sestado, maxlength: 2, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :scontato, "Contato (novo)", class: "form-label" %>
    <%= f.text_field :scontato, maxlength: 30, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :sfone, "Fone (novo)", class: "form-label" %>
    <%= f.text_field :sfone, maxlength: 10, class: "form-control" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :bcra, class: "form-check-input" %>
    <%= f.label :bcra, "CRA", class: "form-check-label" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :bdistelet, class: "form-check-input" %>
    <%= f.label :bdistelet, "Distribuição eletrônica", class: "form-check-label" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :bisentos, class: "form-check-input" %>
    <%= f.label :bisentos, "Isentos", class: "form-check-label" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :bcenprot, class: "form-check-input" %>
    <%= f.label :bcenprot, "CENPROT", class: "form-check-label" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :bpermitedevedoroutrapraca, class: "form-check-input" %>
    <%= f.label :bpermitedevedoroutrapraca, "Permite devedor de outra praça", class: "form-check-label" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
