<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= @apresentante.nome %></h1>
  <div>
    <%= link_to "Editar", edit_apresentante_path(@apresentante), class: "btn btn-primary" %>
    <%= link_to "Voltar", apresentantes_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><strong>Código:</strong> <%= @apresentante.codigo %></li>
    <li class="list-group-item"><strong>Endereço:</strong> <%= @apresentante.endereco %></li>
    <li class="list-group-item"><strong>Fone:</strong> <%= @apresentante.fone %></li>
    <li class="list-group-item"><strong>Contato:</strong> <%= @apresentante.contato %></li>
    <li class="list-group-item"><strong>Agência:</strong> <%= @apresentante.agencia %></li>
    <li class="list-group-item"><strong>Tipo:</strong> <%= @apresentante.tipo %></li>
    <li class="list-group-item"><strong>Convênio:</strong> <%= @apresentante.convenio %></li>
    <li class="list-group-item"><strong>Custa antecipada:</strong> <%= @apresentante.scustaantecipada %></li>
    <li class="list-group-item"><strong>Código de compensação:</strong> <%= @apresentante.scodcompensacao %></li>
    <li class="list-group-item"><strong>CNPJ:</strong> <%= @apresentante.scnpj %></li>
    <li class="list-group-item"><strong>CEP:</strong> <%= @apresentante.scep %></li>
    <li class="list-group-item"><strong>Cidade:</strong> <%= @apresentante.scidade %></li>
    <li class="list-group-item"><strong>Estado:</strong> <%= @apresentante.sestado %></li>
    <li class="list-group-item"><strong>Contato (novo):</strong> <%= @apresentante.scontato %></li>
    <li class="list-group-item"><strong>Fone (novo):</strong> <%= @apresentante.sfone %></li>
    <li class="list-group-item"><strong>CRA:</strong> <%= @apresentante.bcra ? "Sim" : "Não" %></li>
    <li class="list-group-item"><strong>Distribuição eletrônica:</strong> <%= @apresentante.bdistelet ? "Sim" : "Não" %></li>
    <li class="list-group-item"><strong>Isentos:</strong> <%= @apresentante.bisentos ? "Sim" : "Não" %></li>
    <li class="list-group-item"><strong>CENPROT:</strong> <%= @apresentante.bcenprot ? "Sim" : "Não" %></li>
    <li class="list-group-item"><strong>Permite devedor de outra praça:</strong> <%= @apresentante.bpermitedevedoroutrapraca ? "Sim" : "Não" %></li>
  </ul>
</div>
