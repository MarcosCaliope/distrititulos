<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Bancos</h1>
  <%= link_to "Novo banco", new_banco_path, class: "btn btn-primary" %>
</div>

<%= form_with url: bancos_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por código ou nome", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Código</th>
        <th>Banco</th>
        <th>Email</th>
        <th>Data</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @bancos.each do |banco| %>
        <tr>
          <td><%= banco.codigo %></td>
          <td><%= link_to banco.banco, banco %></td>
          <td><%= banco.email %></td>
          <td><%= banco.data %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_banco_path(banco), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", banco, data: { turbo_method: :delete, turbo_confirm: "Remover #{banco.banco}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
