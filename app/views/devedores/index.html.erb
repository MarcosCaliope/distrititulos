<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Devedores</h1>
  <%= link_to "Novo devedor", new_devedor_path, class: "btn btn-primary" %>
</div>

<%= form_with url: devedores_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por nome ou CPF/CNPJ", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Tipo</th>
        <th>CPF/CNPJ</th>
        <th>Nome</th>
        <th>Bairro</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @devedores.each do |devedor| %>
        <tr>
          <td><%= devedor.tipo_doc %></td>
          <td><%= devedor.cpf_cgc %></td>
          <td><%= link_to devedor.nome, devedor %></td>
          <td><%= devedor.sbairro %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_devedor_path(devedor), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", devedor, data: { turbo_method: :delete, turbo_confirm: "Remover #{devedor.nome}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
