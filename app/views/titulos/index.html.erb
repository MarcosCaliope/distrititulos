<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Títulos</h1>
  <%= link_to "Novo título", new_titulo_path, class: "btn btn-primary" %>
</div>

<%= form_with url: titulos_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Protocolo ou número do título", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= text_field_tag :cpf_cgc, params[:cpf_cgc], placeholder: "CPF/CNPJ", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= text_field_tag :devedor, params[:devedor], placeholder: "Nome do devedor", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= number_field_tag :valor, params[:valor], placeholder: "Valor aproximado (±5%)", step: "any", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= label_tag :dat_rece, "Recebimento", class: "visually-hidden" %>
    <%= date_field_tag :dat_rece, params[:dat_rece], class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= label_tag :dat_dist, "Distribuição", class: "visually-hidden" %>
    <%= date_field_tag :dat_dist, params[:dat_dist], class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Protocolo</th>
        <th>Nº título</th>
        <th>CPF/CNPJ</th>
        <th>Devedor</th>
        <th>Valor</th>
        <th>Data recebimento</th>
        <th>Data distribuição</th>
        <th>Status</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @titulos.each do |titulo| %>
        <tr>
          <td><%= link_to titulo.protocolo, titulo %></td>
          <td><%= titulo.num_tit %></td>
          <td><%= titulo.cpf_cgc %></td>
          <td><%= titulo.devedor %></td>
          <td><%= number_to_currency(titulo.valor, unit: "R$") %></td>
          <td><%= titulo.dat_rece %></td>
          <td><%= titulo.dat_dist %></td>
          <td><%= titulo.status %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_titulo_path(titulo), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", titulo, data: { turbo_method: :delete, turbo_confirm: "Remover o título #{titulo.protocolo}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " com os filtros aplicados" if params.values_at(:q, :cpf_cgc, :devedor, :valor, :dat_rece, :dat_dist).any?(&:present?) %>.</p>
