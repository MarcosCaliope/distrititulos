<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Empresas</h1>
  <%= link_to "Nova empresa", new_empresa_path, class: "btn btn-primary" %>
</div>

<%= form_with url: empresas_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por nome", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>CNPJ</th>
        <th>Cidade</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @empresas.each do |empresa| %>
        <tr>
          <td><%= empresa.emp_id %></td>
          <td><%= link_to empresa.snome, empresa %></td>
          <td><%= empresa.scnpj %></td>
          <td><%= empresa.scidade %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_empresa_path(empresa), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", empresa, data: { turbo_method: :delete, turbo_confirm: "Remover #{empresa.snome}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
