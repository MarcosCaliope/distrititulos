<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Tipos de documento</h1>
  <%= link_to "Novo tipo de documento", new_tipo_doc_path, class: "btn btn-primary" %>
</div>

<%= form_with url: tipo_docs_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por código ou descrição", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Código</th>
        <th>Descrição</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @tipo_docs.each do |tipo_doc| %>
        <tr>
          <td><%= link_to tipo_doc.tipo_doc, tipo_doc %></td>
          <td><%= tipo_doc.descricao %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_tipo_doc_path(tipo_doc), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", tipo_doc, data: { turbo_method: :delete, turbo_confirm: "Remover #{tipo_doc.descricao}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
