<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= @tipo_doc.descricao %></h1>
  <div>
    <%= link_to "Editar", edit_tipo_doc_path(@tipo_doc), class: "btn btn-primary" %>
    <%= link_to "Voltar", tipo_docs_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><strong>Código:</strong> <%= @tipo_doc.tipo_doc %></li>
    <li class="list-group-item"><strong>Descrição:</strong> <%= @tipo_doc.descricao %></li>
  </ul>
</div>
