<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Ato <%= @ato.icodato %>/<%= @ato.ano %></h1>
  <div>
    <%= link_to "Editar", edit_ato_path(@ato), class: "btn btn-primary" %>
    <%= link_to "Voltar", atos_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><strong>Código:</strong> <%= @ato.icodato %></li>
    <li class="list-group-item"><strong>Ano:</strong> <%= @ato.ano %></li>
    <li class="list-group-item"><strong>Emolumento:</strong> <%= @ato.cemolumento %></li>
    <li class="list-group-item"><strong>Fermoju:</strong> <%= @ato.cfermoju %></li>
    <li class="list-group-item"><strong>Selo:</strong> <%= @ato.cselo %></li>
    <li class="list-group-item"><strong>ISS:</strong> <%= @ato.ciss %></li>
    <li class="list-group-item"><strong>FAADEP:</strong> <%= @ato.cfaadep %></li>
    <li class="list-group-item"><strong>FRMP:</strong> <%= @ato.cfrmp %></li>
    <li class="list-group-item"><strong>Total:</strong> <%= number_to_currency(@ato.valor_total, unit: "R$") %></li>
  </ul>
</div>
