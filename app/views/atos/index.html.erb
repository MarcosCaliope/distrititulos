<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Atos</h1>
  <%= link_to "Novo ato", new_ato_path, class: "btn btn-primary" %>
</div>

<%= form_with url: atos_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por código ou ano", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Código</th>
        <th>Ano</th>
        <th>Emolumento</th>
        <th>Fermoju</th>
        <th>Selo</th>
        <th>ISS</th>
        <th>FAADEP</th>
        <th>FRMP</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @atos.each do |ato| %>
        <tr>
          <td><%= link_to ato.icodato, ato %></td>
          <td><%= ato.ano %></td>
          <td><%= ato.cemolumento %></td>
          <td><%= ato.cfermoju %></td>
          <td><%= ato.cselo %></td>
          <td><%= ato.ciss %></td>
          <td><%= ato.cfaadep %></td>
          <td><%= ato.cfrmp %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_ato_path(ato), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", ato, data: { turbo_method: :delete, turbo_confirm: "Remover o ato #{ato.icodato}/#{ato.ano}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 50 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
