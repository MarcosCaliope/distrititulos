<%= form_with model: irregularidade do |f| %>
  <% if irregularidade.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h5"><%= pluralize(irregularidade.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul class="mb-0">
        <% irregularidade.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :codigo, class: "form-label" %>
    <%= f.number_field :codigo, readonly: irregularidade.persisted?, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :descricao, "Descrição", class: "form-label" %>
    <%= f.text_field :descricao, maxlength: 100, class: "form-control" %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
