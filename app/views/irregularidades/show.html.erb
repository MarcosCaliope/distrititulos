<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Irregularidade <%= @irregularidade.codigo %></h1>
  <div>
    <%= link_to "Editar", edit_irregularidade_path(@irregularidade), class: "btn btn-primary" %>
    <%= link_to "Voltar", irregularidades_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><strong>Código:</strong> <%= @irregularidade.codigo %></li>
    <li class="list-group-item"><strong>Descrição:</strong> <%= @irregularidade.descricao %></li>
  </ul>
</div>
