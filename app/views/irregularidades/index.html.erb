<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Irregularidades</h1>
  <%= link_to "Nova irregularidade", new_irregularidade_path, class: "btn btn-primary" %>
</div>

<%= form_with url: irregularidades_path, method: :get, class: "row g-2 mb-4" do %>
  <div class="col-auto">
    <%= text_field_tag :q, params[:q], placeholder: "Buscar por descrição", class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Buscar", class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Código</th>
        <th>Descrição</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @irregularidades.each do |irregularidade| %>
        <tr>
          <td><%= link_to irregularidade.codigo, irregularidade %></td>
          <td><%= irregularidade.descricao %></td>
          <td class="text-end">
            <%= link_to "Editar", edit_irregularidade_path(irregularidade), class: "btn btn-sm btn-outline-secondary" %>
            <%= link_to "Remover", irregularidade, data: { turbo_method: :delete, turbo_confirm: "Remover a irregularidade #{irregularidade.codigo}?" }, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="text-muted">Mostrando até 100 registros<%= " para \"#{params[:q]}\"" if params[:q].present? %>.</p>
